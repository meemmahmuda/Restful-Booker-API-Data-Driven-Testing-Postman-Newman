    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Fetch first name for DDT\r",
              "var firstName = pm.iterationData.get('firstname');\r",
              "pm.environment.set(\"fName\" , firstName);\r",
              "\r",
              "// Fetch last name for DDT\r",
              "var lastName = pm.iterationData.get('lastname');\r",
              "pm.environment.set(\"lName\" , lastName);\r",
              "\r",
              "// Fetch total price for DDT\r",
              "var totalPrice = pm.iterationData.get('totalprice');\r",
              "pm.environment.set(\"tPrice\" , totalPrice);\r",
              "\r",
              "// Fetch deposit paid for DDT\r",
              "var depositPaid = pm.iterationData.get('depositpaid');\r",
              "pm.environment.set(\"dPaid\" , depositPaid);\r",
              "\r",
              "// Fetch checkin for DDT\r",
              "var checkIn = pm.iterationData.get('checkin');\r",
              "pm.environment.set(\"checkin\" , checkIn);\r",
              "\r",
              "// Fetch checkout for DDT\r",
              "var checkOut = pm.iterationData.get('checkout');\r",
              "pm.environment.set(\"checkout\" , checkOut);\r",
              "\r",
              "// Fetch additionalneeds for DDT\r",
              "var additionalNeeds = pm.iterationData.get('additionalneeds');\r",
              "pm.environment.set(\"additionalneeds\" , additionalNeeds);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responsebody = pm.response.json();\r",
              "pm.environment.set(\"id\",responsebody.bookingid);\r",
              "\r",
              "// Assertion for status code\r",
              "pm.test(\"Verify that Status code is 201 or not\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Assertion for time\r",
              "pm.test(\"Verify that the response time is below 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// Assertion for size\r",
              "pm.test(\"Verify that the response size is below 1000B\", function () {\r",
              "    pm.expect(pm.response.responseSize).to.be.below(1000);\r",
              "});\r",
              "\r",
              "// Assertion for first name\r",
              "var responsebody = pm.response.json();\r",
              "pm.test(\"Verify that the response first name is same as environment\", function () {\r",
              "    pm.expect(pm.environment.get(\"fName\")).to.eql(responsebody.booking.firstname);\r",
              "});\r",
              "\r",
              "// Assertion for last name\r",
              "pm.test(\"Verify that the response last name is same as environment\", function () {\r",
              "    pm.expect(pm.environment.get(\"lName\")).to.eql(responsebody.booking.lastname);\r",
              "});\r",
              "\r",
              "// Assertion for total price\r",
              "pm.test(\"Verify that the response total price is same as environment\", function () {\r",
              "    pm.expect(pm.environment.get(\"tPrice\")).to.eql(responsebody.booking.totalprice);\r",
              "});\r",
              "\r",
              "// Assertion for deposit paid\r",
              "pm.test(\"Verify that the response deposit paid is same as environment\", function () {\r",
              "    var expectedValue = pm.environment.get(\"dPaid\");\r",
              "    var actualValue = responsebody.booking.depositpaid;\r",
              "    pm.expect(expectedValue == 1).to.eql(actualValue);\r",
              "});\r",
              "\r",
              "// Assertion for checkin date\r",
              "pm.test(\"Verify that the response checkin date is same as environment\", function () {\r",
              "    pm.expect(pm.environment.get(\"checkin\")).to.eql(responsebody.booking.bookingdates.checkin);\r",
              "});\r",
              "\r",
              "// Assertion for checkout date\r",
              "pm.test(\"Verify that the response checkout date is same as DDT\", function () {\r",
              "    pm.expect(pm.environment.get(\"checkout\")).to.eql(responsebody.booking.bookingdates.checkout);\r",
              "});\r",
              "\r",
              "// Assertion for additional needs\r",
              "pm.test(\"Verify that the response additional needs is same as environment\", function () {\r",
              "    pm.expect(pm.environment.get(\"additionalneeds\")).to.eql(responsebody.booking.additionalneeds);\r",
              "});\r",
              "\r",
              "// Assertion for firstname is string\r",
              "pm.test(\"Verify first name is a string\", function () {\r",
              "    pm.expect(responsebody.booking.firstname).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// Assertion for lastname is string\r",
              "pm.test(\"Verify last name is a string\", function () {\r",
              "    pm.expect(responsebody.booking.lastname).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// Assertion for totalprice is number\r",
              "pm.test(\"Verify total price is a number\", function () {\r",
              "    pm.expect(responsebody.booking.totalprice).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "// Assertion for depositpaid is boolean\r",
              "pm.test(\"Verify deposit paid is a boolean\", function () {\r",
              "    pm.expect(responsebody.booking.depositpaid).to.be.a(\"boolean\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
