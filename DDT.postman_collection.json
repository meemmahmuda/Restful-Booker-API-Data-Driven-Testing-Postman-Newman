    {
      "name": "UpdateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Fetch first name\r",
              "var firstName = pm.iterationData.get(\"put_firstname\");\r",
              "pm.environment.set(\"fName\", firstName);\r",
              "\r",
              "// Fetch last name\r",
              "var lastName = pm.iterationData.get(\"put_lastname\");\r",
              "pm.environment.set(\"lName\", lastName);\r",
              "\r",
              "// Fetch total price\r",
              "var totalPrice = Number(pm.iterationData.get(\"put_totalprice\"));\r",
              "pm.environment.set(\"tPrice\", totalPrice);\r",
              "\r",
              "// Fetch deposit paid\r",
              "var depositPaid = String(pm.iterationData.get(\"put_depositpaid\")).toLowerCase() === \"true\";\r",
              "pm.environment.set(\"dPaid\", depositPaid);\r",
              "\r",
              "// Fetch check-in\r",
              "var checkIn = pm.iterationData.get(\"put_checkin\");\r",
              "pm.environment.set(\"checkin\", checkIn);\r",
              "\r",
              "// Fetch check-out\r",
              "var checkOut = pm.iterationData.get(\"put_checkout\");\r",
              "pm.environment.set(\"checkout\", checkOut);\r",
              "\r",
              "// Fetch additional needs\r",
              "var additionalNeeds = pm.iterationData.get(\"put_additionalneeds\");\r",
              "pm.environment.set(\"additionalneeds\", additionalNeeds);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json();\r",
              "\r",
              "// Status code\r",
              "pm.test(\"Verify status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Response time\r",
              "pm.test(\"Verify response time is below 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// Response size\r",
              "pm.test(\"Verify response size is below 1000B\", function () {\r",
              "    pm.expect(pm.response.responseSize).to.be.below(1000);\r",
              "});\r",
              "\r",
              "// First name\r",
              "pm.test(\"Verify updated first name\", function () {\r",
              "    pm.expect(responseBody.firstname).to.eql(\r",
              "        pm.iterationData.get(\"put_firstname\")\r",
              "    );\r",
              "});\r",
              "\r",
              "// Last name\r",
              "pm.test(\"Verify updated last name\", function () {\r",
              "    pm.expect(responseBody.lastname).to.eql(\r",
              "        pm.iterationData.get(\"put_lastname\")\r",
              "    );\r",
              "});\r",
              "\r",
              "// Total price\r",
              "pm.test(\"Verify updated total price\", function () {\r",
              "    pm.expect(responseBody.totalprice).to.eql(\r",
              "        Number(pm.iterationData.get(\"put_totalprice\"))\r",
              "    );\r",
              "});\r",
              "\r",
              "// Deposit paid\r",
              "pm.test(\"Verify deposit paid is correct\", function () {\r",
              "    var expectedDeposit = String(\r",
              "        pm.iterationData.get(\"put_depositpaid\")\r",
              "    ).toLowerCase() === \"true\";\r",
              "\r",
              "    pm.expect(responseBody.depositpaid).to.eql(expectedDeposit);\r",
              "});\r",
              "\r",
              "// Check-in date\r",
              "pm.test(\"Verify check-in date\", function () {\r",
              "    pm.expect(responseBody.bookingdates.checkin).to.eql(\r",
              "        pm.iterationData.get(\"put_checkin\")\r",
              "    );\r",
              "});\r",
              "\r",
              "// Check-out date\r",
              "pm.test(\"Verify check-out date\", function () {\r",
              "    pm.expect(responseBody.bookingdates.checkout).to.eql(\r",
              "        pm.iterationData.get(\"put_checkout\")\r",
              "    );\r",
              "});\r",
              "\r",
              "// Additional needs\r",
              "pm.test(\"Verify additional needs\", function () {\r",
              "    pm.expect(responseBody.additionalneeds).to.eql(\r",
              "        pm.iterationData.get(\"put_additionalneeds\")\r",
              "    );\r",
              "});\r",
              "\r",
              "// Data types\r",
              "pm.test(\"Verify first name is a string\", function () {\r",
              "    pm.expect(responseBody.firstname).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Verify last name is a string\", function () {\r",
              "    pm.expect(responseBody.lastname).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Verify total price is a number\", function () {\r",
              "    pm.expect(responseBody.totalprice).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Verify deposit paid is a boolean\", function () {\r",
              "    pm.expect(responseBody.depositpaid).to.be.a(\"boolean\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
